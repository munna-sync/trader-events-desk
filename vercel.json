{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/discover", "schedule": "15 0 * * *" }
  ],
  "functions": {
    "api/cron/discover.js": { "maxDuration": 300 },
    "api/admin/ai.js": { "maxDuration": 300 }
  },
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
